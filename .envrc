use flake

# Use UV to create venv if there isn't any
if [ ! -e .venv ]; then
    uv venv --python python3.12  # Use Python 3.12
    uv pip install torch==2.7.1
    uv pip install numpy
    uv pip install "cocotb[bus]==1.9.2"
    uv pip install bitstring
    uv pip install colorlog
    uv pip install toml
    uv pip install -e . || echo "Warning: Could not install main project"
fi

source .venv/bin/activate

export PYTHONPATH="$PWD/tools:${PYTHONPATH:-}"

# Use PyTorch pre-built library to avoid supplying our own.
export LIBTORCH_USE_PYTORCH=1
export LIBTORCH_BYPASS_VERSION_CHECK=1

# Add GCC C++ standard library and other system library paths
GCC_LIB_PATH=$(nix-build '<nixpkgs>' -A gcc.cc.lib --no-out-link 2>/dev/null)/lib
export LD_LIBRARY_PATH="/run/opengl-driver/lib:$PWD/.venv/lib/python3.12/site-packages/torch/lib:${GCC_LIB_PATH}:${NIX_LD_LIBRARY_PATH:-}:${LD_LIBRARY_PATH:-}"