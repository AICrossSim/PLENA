# dc-asap7
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#  ASAP7 7nm Library Setup for IP Core Design
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

set techlib_path    ./lib/asap7
set std_cell_path   ${techlib_path}/asap7sc7p5tnldm_28
# Note: ASAP7 does not include I/O libraries (academic PDK for research)
# This setup is optimized for IP core design (no IO pads required)

# ASAP7 lib setting (RVT TT corner) - use the compilied .db files
#read_lib $std_cell_path/asap7sc7p5t_SIMPLE_RVT_TT_ccs_211120.lib
#read_lib $std_cell_path/asap7sc7p5t_AO_RVT_TT_ccs_211120.lib
#read_lib $std_cell_path/asap7sc7p5t_SEQ_RVT_TT_ccs_220123.lib
#read_lib $std_cell_path/asap7sc7p5t_INVBUF_RVT_TT_ccs_220122.lib
#read_lib 
#                         asap7sc7p5t_AO_RVT_TT_ccs_211120.lib \
#                         asap7sc7p5t_SEQ_RVT_TT_ccs_220123.lib \
#                         asap7sc7p5t_INVBUF_RVT_TT_ccs_220122.lib"
#/workspace/tools/synopsys/asap7sc7p5t_AO_LVT_TT_nldm_211120.lib
#/workspace/tools/synopsys/asap7sc7p5t_INVBUF_LVT_TT_nldm_220122.lib
#/workspace/tools/synopsys/asap7sc7p5t_OA_LVT_TT_nldm_211120.lib
#/workspace/tools/synopsys/asap7sc7p5t_SEQ_LVT_TT_nldm_220123.lib
#/workspace/tools/synopsys/asap7sc7p5t_SIMPLE_LVT_TT_nldm_211120.lib

set target_library      "asap7sc7p5t_AO_LVT_TT_nldm_211120.db \
                         asap7sc7p5t_INVBUF_LVT_TT_nldm_211120.db \
                         asap7sc7p5t_OA_LVT_TT_nldm_211120.db \
                         asap7sc7p5t_SEQ_LVT_TT_nldm_220123.db \
                         asap7sc7p5t_SIMPLE_LVT_TT_nldm_211120.db"

set link_libray         "* \
                         asap7sc7p5t_AO_LVT_TT_nldm_211120.db \
                         asap7sc7p5t_INVBUF_LVT_TT_nldm_211120.db \
                         asap7sc7p5t_OA_LVT_TT_nldm_211120.db \
                         asap7sc7p5t_SEQ_LVT_TT_nldm_220123.db \
                         asap7sc7p5t_SIMPLE_LVT_TT_nldm_211120 \
                         dw_foundation.sldb"

#set target_library      "asap7sc7p5t_AO_RVT_TT_201020.v \
#                        asap7sc7p5t_INVBUF_RVT_TT_201020.v \
#                        asap7sc7p5t_SEQ_RVT_TT_220101.v \
#                        asap7sc7p5t_SIMPLE_RVT_TT_201020.v"
                
#set link_library      " *\
#                        asap7sc7p5t_AO_RVT_TT_201020.v \
#                        asap7sc7p5t_INVBUF_RVT_TT_201020.v \
#                        asap7sc7p5t_SEQ_RVT_TT_220101.v \
#                        asap7sc7p5t_SIMPLE_RVT_TT_201020.v \
#                        dw_foundation.sldb"

#set link_library        "* \
#                         asap7sc7p5t_SIMPLE_RVT_TT_ccs_211120.lib \
#                         asap7sc7p5t_AO_RVT_TT_ccs_211120.lib \
#                         asap7sc7p5t_SEQ_RVT_TT_ccs_220123.lib \
#                         asap7sc7p5t_INVBUF_RVT_TT_ccs_220122.lib \
#                         dw_foundation.sldb"

set synthetic_library   "dw_foundation.sldb"

# set_time_unit 1ps


# search path set
set search_path [list . ${synopsys_root}/libraries/syn]
lappend search_path ${std_cell_path}

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#  Debug 
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

echo "\n\nASAP7 7nm Settings for IP Core Design:"
echo "techlib_path:      $techlib_path"
echo "std_cell_path:     $std_cell_path"
echo "search_path:       $search_path"
echo "link_library:      $link_library"
echo "target_library:    $target_library"


define_design_lib WORK -path ./analyzed/WORK

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#  History
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

history keep 200

set verilogout_equation false
set verilogout_no_tri true
set verilogout_show_unconnected_pins true
set hdl_naming_threshold 1
set template_naming_style "%s"
suppress_message VER-936
suppress_message VER-130
suppress_message VER-318
suppress_message VER-173


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#  Define naming rule
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

define_name_rules asic_top_rules \
-allowed "a-zA-Z0-9_()[]" \
-max_length 16 \
-case_insensitive \
-first_restricted "_" \
-last_restricted "_" \
-map {{"\*cell\*","U"},{"*-return","RET"}};

define_name_rules asic_core_rules \
-allowed "a-zA-Z0-9_()[]" \
-max_length 255 \
-case_insensitive \
-last_restricted "_" \
-first_restricted "_" \
-map {{"\*cell\*","U"},{"*-return","RET"}};


# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#  Aliases
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

alias h history
alias rc "report_constraint -all_violators"
alias rt report_timing
alias ra report_area
alias page_on {set sh_enable_page_mode true}
alias page_off {set sh_enable_page_mode false}
alias fr "remove_design -designs"

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#  Alib for compile_ultra
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

page_off
set alib_library_analysis_path ..
echo "\n\nASAP7 7nm PDK ready for IP core synthesis...\n"
